# Call routing (steps 1-2)
# ANSWER_MODE=bot         — assistant picks up immediately. Use when your cell
#                           forwards to Twilio on no-answer (the ringing has
#                           already happened, so don't dial back out).
# ANSWER_MODE=dial-first  — Twilio is the number people dial: ring the cell
#                           first, fall back to the bot. Uses the two below.
ANSWER_MODE=bot
FORWARD_TO_NUMBER=+18084649192
DIAL_TIMEOUT=15

# Relay (step 3) — public host baked into the wss:// URL
PUBLIC_DOMAIN=sparkal.ai

# Voice (TTS) — Google/Amazon need no setup; ElevenLabs needs a key in the
# Twilio Console. See Twilio's ConversationRelay voices doc for valid IDs.
TTS_PROVIDER=Google
TTS_VOICE=en-US-Journey-F

# Twilio event subscriptions, space-separated. "speaker-events" is what tells
# us when TTS and the caller start and stop — the silence clock and the hangup
# both key off it, so don't drop it. Add "tokens-played" to debug playback.
RELAY_EVENTS=speaker-events

# Silence — a caller who says nothing sends no messages, so the bot watches
# the clock. Quiet for SILENCE_PROMPT_SECONDS gets "Are you still there?";
# quiet again for SILENCE_HANGUP_SECONDS gets a goodbye and a hangup. These
# count only genuine dead air (nobody speaking, nothing generating), so they
# can be short.
SILENCE_PROMPT_SECONDS=10
SILENCE_HANGUP_SECONDS=10
# Fallback only. The goodbye's stop event normally triggers the hangup the
# moment playback ends; this caps the wait if that event never arrives.
END_GRACE_SECONDS=8

# LLM (step 4)
ANTHROPIC_API_KEY=
LLM_PRIMARY=claude-haiku-4-5
LLM_MAX_TOKENS=200

# Notify (step 5) — text the message summary to your cell
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # your Twilio number, E.164, SMS-capable
NOTIFY_SMS_TO=+18084649192
